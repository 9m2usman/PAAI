GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Optional Google OAuth configuration for Phase 5
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Required for authentication; use a random secret of at least 32 characters.
PAAI_AUTH_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# Optional production settings
PAAI_DATA_DIR=data
PAAI_HOST=0.0.0.0
PAAI_PORT=8000
PAAI_LOG_LEVEL=INFO
PAAI_CORS_ORIGINS=http://localhost:3000
PAAI_MAX_REQUEST_BYTES=1048576
PAAI_REQUESTS_PER_MINUTE=120
PAAI_TOKEN_LIFETIME_SECONDS=3600
PAAI_ENABLE_DOCS=false

# Enable only when goal descriptions should be translated into real integrations.
# Individual connector permissions and human approval requirements still apply.
PAAI_ENABLE_INTEGRATION_GOAL_EXECUTOR=false

# Generate with CredentialCipher.generate_key(). Keep outside the database and repository.
PAAI_CREDENTIAL_ENCRYPTION_KEY=
PAAI_CREDENTIAL_DATABASE=data/paai_credentials.db
